<Project>
  <PropertyGroup>
    <LocalSymHelp>$(MSBuildThisFileDirectory)\..\..\SymHelp\src\SymHelp\bin\Debug\netstandard2.0\SymHelp.dll</LocalSymHelp>

    <DefineConstants Condition="!Exists('$(LocalSymHelp)')">$(DefineConstants);DISABLE_SYMHELP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- If SymHelp has been cloned to the parent directory containing both SymHelp and PESpy,
         prefer the local version for development purposes -->
    <!--<PackageReference Include="SymHelp" Version="$(SymHelpVersion)" Condition="!Exists('$(LocalSymHelp)')" />-->

    <Reference Include="SymHelp" Condition="Exists('$(LocalSymHelp)')">
      <HintPath>$(LocalSymHelp)</HintPath>
    </Reference>
  </ItemGroup>
</Project>