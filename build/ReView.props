<Project>
  <PropertyGroup>
    <LocalReView>$(MSBuildThisFileDirectory)\..\..\ReView\src\ReView\bin\Debug\net5.0-windows\ReView.dll</LocalReView>

    <DefineConstants Condition="!Exists('$(LocalReView)')">$(DefineConstants);DISABLE_REVIEW</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- If ReView has been cloned to the parent directory containing both ReView and PESpy,
         prefer the local version for development purposes -->
    <!--<PackageReference Include="ReView" Version="$(ReViewVersion)" Condition="!Exists('$(LocalReView)')" />-->

    <Reference Include="ReView" Condition="Exists('$(LocalReView)')">
      <HintPath>$(LocalReView)</HintPath>
    </Reference>
  </ItemGroup>
</Project>